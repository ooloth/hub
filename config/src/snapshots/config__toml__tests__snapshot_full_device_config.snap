---
source: config/src/toml.rs
expression: result
---
HubToml {
    project: [
        Project {
            name: "myapp",
            repo: "org/myapp",
            workflow: [
                GithubPrs {
                    exclude_authors: [
                        "dependabot",
                    ],
                },
                GithubIssues,
            ],
            environment: [
                Environment {
                    env: "internal",
                    gcp_project: None,
                    gcp_region: None,
                    loki_endpoint: Some(
                        "https://loki.example.com",
                    ),
                    grafana_url: Some(
                        "https://grafana.example.com",
                    ),
                    workflow: [
                        LokiLogs {
                            title: "app errors",
                            query: "{app=\"myapp\"} | logfmt | level=\"error\"",
                            lookback: Some(
                                "1h",
                            ),
                            message_field: None,
                        },
                    ],
                },
                Environment {
                    env: "neuro",
                    gcp_project: Some(
                        "org-prod",
                    ),
                    gcp_region: Some(
                        "us-central1",
                    ),
                    loki_endpoint: None,
                    grafana_url: None,
                    workflow: [
                        GcpLogs {
                            title: "errors",
                            query: "resource.type=\"cloud_run_revision\" AND severity>=ERROR",
                            lookback: None,
                            message_field: None,
                        },
                        GcpLogs {
                            title: "errors (external)",
                            query: "resource.type=\"cloud_run_revision\" AND severity>=ERROR AND labels.\"user-type\"=\"external\"",
                            lookback: Some(
                                "30m",
                            ),
                            message_field: None,
                        },
                    ],
                },
            ],
        },
    ],
    monitor: Some(
        Monitor {
            workflow: [
                MonitorWorkflowConfig {
                    name: "github-prs",
                },
            ],
        },
    ),
}
