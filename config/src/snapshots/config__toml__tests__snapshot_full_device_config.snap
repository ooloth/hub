---
source: config/src/toml.rs
expression: result
---
HubToml {
    project: [
        Project {
            name: "myapp",
            repo: "org/myapp",
            workflow: [
                GithubPrs {
                    exclude_authors: [
                        "dependabot",
                    ],
                },
                GithubIssues,
            ],
            environment: [
                Environment {
                    env: "internal",
                    gcp_project: None,
                    gcp_region: None,
                    service: None,
                    cluster: Some(
                        "internal-cluster",
                    ),
                    namespace: Some(
                        "default",
                    ),
                    loki_endpoint: None,
                    grafana_url: None,
                    workflow: [
                        LokiLogs {
                            title: "app errors",
                            query: "{app=\"myapp\"} | logfmt | level=\"error\"",
                            lookback: Some(
                                "1h",
                            ),
                            error_threshold: Some(
                                10,
                            ),
                        },
                    ],
                },
                Environment {
                    env: "prod",
                    gcp_project: Some(
                        "org-prod",
                    ),
                    gcp_region: Some(
                        "us-central1",
                    ),
                    service: Some(
                        "myapp",
                    ),
                    cluster: None,
                    namespace: None,
                    loki_endpoint: None,
                    grafana_url: None,
                    workflow: [
                        UserActivityGcp {
                            include_users: [
                                "alice@example.com",
                            ],
                            exclude_users: [],
                        },
                        ErrorsGcp {
                            exclude_users: [
                                "bot@example.com",
                            ],
                        },
                        WarningsGcp {
                            exclude_users: [],
                        },
                    ],
                },
            ],
        },
    ],
    monitor: Some(
        Monitor {
            workflow: [
                MonitorWorkflowConfig {
                    name: "github-prs",
                },
            ],
        },
    ),
}
