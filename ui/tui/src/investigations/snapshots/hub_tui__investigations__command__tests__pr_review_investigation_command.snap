---
source: ui/tui/src/investigations/command.rs
expression: "compose_for_snapshot(config, None, None)"
---
cwd: /tmp/hub-test-worktree
env:
  HUB_LAUNCHER=claude
  HUB_SYSTEM_PROMPT=<system prompt starting "PR #7 (ooloth/hub). This is your PR. Identify issues; make no local changes.">
  HUB_TASK_PROMPT=/review-code PR #7 (ooloth/hub)
shell: "$HUB_LAUNCHER" --permission-mode auto --strict-mcp-config --model opus --allowedTools 'Bash,Read,Edit,Write,Glob,Grep' --append-system-prompt "$HUB_SYSTEM_PROMPT" "$HUB_TASK_PROMPT"
