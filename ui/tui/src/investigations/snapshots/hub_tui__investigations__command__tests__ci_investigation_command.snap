---
source: ui/tui/src/investigations/command.rs
expression: "compose_for_snapshot(config, Some(CLEANUP), None)"
---
cwd: /tmp/hub-test-worktree
env:
  HUB_LAUNCHER=claude
  HUB_SYSTEM_PROMPT=<system prompt starting "## Purpose">
  HUB_TASK_PROMPT=Investigate the CI failure for repo ooloth/hub. Run URL: https://github.com/ooloth/hub/actions/runs/123
shell: "$HUB_LAUNCHER" --permission-mode auto --strict-mcp-config --model opus --allowedTools 'Bash' --append-system-prompt "$HUB_SYSTEM_PROMPT" "$HUB_TASK_PROMPT"; cd ~ && git -C '/tmp/bare' worktree remove --force '/tmp/wt' 2>/dev/null || true
